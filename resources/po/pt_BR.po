#: dist/extension.js:409
msgid "Reset all applications to default output"
msgstr "Redefinir todos os aplicativos para a saída padrão"

#: dist/prefs.js:31
msgid "Where the panel should be"
msgstr "Onde o painel deve estar"

#: dist/prefs.js:33
msgid "Independent panel"
msgstr "Painel independente"

#: dist/prefs.js:34
msgid "In the main panel"
msgstr "No painel principal"

#: dist/prefs.js:35
msgid "In a separate indicator"
msgstr "Em um indicador separado"

#: dist/prefs.js:40
msgid "Panel position"
msgstr "Posição do painel"

#: dist/prefs.js:41
msgid "Where the new panel should be located relative to the main panel"
msgstr "Onde o novo painel deve ser localizado em relação ao painel principal"

#: dist/prefs.js:43
msgid "Top"
msgstr "Topo"

#: dist/prefs.js:44
msgid "Bottom"
msgstr "Baixo"

#: dist/prefs.js:52
msgid "Always show microphone volume slider"
msgstr "Sempre mostrar o controle de volume do microfone"

#: dist/prefs.js:53
msgid "Show even when there is no application recording audio"
msgstr "Mostrar mesmo quando nenhum aplicativo estiver gravando áudio"

#: dist/prefs.js:56
msgid "Don't show the microphone indicator when there is only virtual captures"
msgstr ""
"Não mostrar o indicador do microfone quando houver apenas capturas virtuais"

#: dist/prefs.js:59
msgid "Remove the main output volume slider"
msgstr "Remover o controle de volume da saída principal"

#: dist/prefs.js:60
msgid "This is useful if you enabled the per-device volume sliders"
msgstr "Isso é útil se você ativou os controles de volume por dispositivo"

#: dist/prefs.js:63
msgid "Show the currently selected device for the main volume sliders"
msgstr ""
"Mostrar o dispositivo atualmente selecionado para os controles de volume "
"principais"

#: dist/prefs.js:66
msgid "Add a button to reset all applications to the default output"
msgstr ""
"Não mostrar o indicador do microfone quando houver apenas capturas virtuais"

#: dist/prefs.js:67
msgid ""
"This button can be found in the device chooser of the main output slider"
msgstr ""
"Este botão pode ser encontrado no seletor de dispositivos do controle "
"deslizante de saída principal"

#: dist/prefs.js:70
msgid "Do not apply custom CSS"
msgstr "Não aplicar CSS personalizado"

#: dist/prefs.js:71
msgid "Disable the CSS in this extension that could override your theme"
msgstr "Desativar o CSS nesta extensão que poderia sobrescrever seu tema"

#: dist/prefs.js:74
msgid "Path to the <tt>pactl</tt> executable"
msgstr "Caminho para o executável <tt>pactl</tt>"

#: dist/prefs.js:79
msgid "Auto-hide"
msgstr "Ocultar automaticamente"

#: dist/prefs.js:80
msgid "Hide the profile switcher when the current device only has one profile"
msgstr ""
"Ocultar o seletor de perfil quando o dispositivo atual tiver apenas um perfil"

#: dist/prefs.js:84
msgid "Add a 'set as active' button"
msgstr "Adicionar um botão 'definir como ativo'"

#: dist/prefs.js:85
msgid ""
"This button, added on each device slider, has the same effect as clicking on "
"that device in the main volume slider menu"
msgstr ""
"Este botão, adicionado em cada controle deslizante de dispositivo, tem o "
"mesmo efeito de clicar naquele dispositivo no menu principal do controle "
"deslizante de volume"

#: dist/prefs.js:88
msgid "Replace the 'set as active' button with a submenu"
msgstr "Substitua o botão 'definir como ativo' por um submenu"

#: dist/prefs.js:89
msgid ""
"For devices which have multiple ports, the button will be replaced by a "
"submenu to choose which port will be active"
msgstr ""
"Para dispositivos que possuem múltiplas portas, o botão será substituído por "
"um submenu para escolher qual porta estará ativa"

#: dist/prefs.js:94
msgid "Move media controls"
msgstr "Mover controles de mídia"

#: dist/prefs.js:95
msgid ""
"Move the media controls from the notifications panel instead of creating a "
"new one"
msgstr ""
"Mover os controles de mídia do painel de notificações em vez de criar um novo"

#: dist/prefs.js:99
msgid "Display the name of the application and the stream"
msgstr "Exibir o nome do aplicativo e do fluxo"

#: dist/prefs.js:102
msgid "Put the sliders in submenu"
msgstr "Colocar os controles deslizantes em um submenu"

#: dist/prefs.js:103
msgid ""
"<span color=\"darkorange\" weight=\"bold\">This will disable the ability to "
"change the output device per application</span>"
msgstr ""
"<span color=\"darkorange\" weight=\"bold\">Isso desativará a capacidade de "
"alterar o dispositivo de saída por aplicativo</span>"

#: dist/prefs.js:106
msgid "Open the submenu from the output volume slider"
msgstr "Abrir o submenu pelo controle de volume de saída"

#: dist/prefs.js:107
msgid ""
"Instead of a separate item, add a button next to the output device chooser "
"to open the submenu"
msgstr ""
"Em vez de um item separado, adiciona um botão ao lado do seletor de "
"dispositivo de saída para abrir o submenu"

#: dist/prefs.js:111
msgid "Combine streams from the same application"
msgstr "Combinar fluxos do mesmo aplicativo"

#: dist/prefs.js:112
msgid ""
"Show one slider for an application with multiple audio streams. Volume and "
"mute changes apply to every stream."
msgstr ""
"Exibe um único controle deslizante para aplicativos com vários fluxos de "
"áudio. Alterações de volume e mudo se aplicam a todos os fluxos."

#: dist/prefs.js:115
msgid "Allow automatic execution of <tt>pactl</tt>"
msgstr "Permitir a execução automática do <tt>pactl</tt>"

#: dist/prefs.js:116
msgid ""
"This feature might cause some minor lag, but it's necessary to get the real "
"name of Chromium applications and detect the application's current output "
"device"
msgstr ""
"Este recurso pode causar uma pequena lentidão, mas é necessário para obter o "
"nome real de aplicativos Chromium e detectar o dispositivo de saída atual do "
"aplicativo"

#: dist/prefs.js:120
msgid "Elements order"
msgstr "Ordem dos elementos"

#: dist/prefs.js:121
msgid "Reorder elements in the new panel"
msgstr "Reordenar elementos no novo painel"

#: dist/prefs.js:125
msgid "Profile switcher"
msgstr "Seletor de perfil"

#: dist/prefs.js:126
msgid "Allows you to quickly change the audio profile of the current device"
msgstr ""
"Permite que você altere rapidamente o perfil de áudio do dispositivo atual"

#: dist/prefs.js:132
msgid "Speaker / Headphone volume slider"
msgstr "Controle de volume do Fone de Ouvido / Speaker"

#: dist/prefs.js:137
msgid "Per-device volume sliders"
msgstr "Controles de volume por dispositivo"

#: dist/prefs.js:142
msgid "Audio balance slider"
msgstr "Controle de balanço de áudio"

#: dist/prefs.js:146
msgid "Microphone volume slider"
msgstr "Controle de volume do microfone"

#: dist/prefs.js:150
msgid "Media controls"
msgstr "Controles de mídia"

#: dist/prefs.js:155
msgid "Applications mixer"
msgstr "Mixer de aplicativos"

#: dist/prefs.js:162
msgid "The same sliders you can find in pavucontrol or in the sound settings"
msgstr ""
"Os mesmos controles que você pode encontrar no pavucontrol ou nas "
"configurações de som"

#: dist/prefs.js:166
msgid ""
"<span color=\"darkorange\" weight=\"bold\"><tt>pactl</tt> was not found, you "
"won't be able to change the output device per application</span>"
msgstr ""
"<span color=\"darkorange\" weight=\"bold\"><tt>pactl</tt> não foi "
"encontrado, você não poderá alterar o dispositivo de saída por aplicativo</"
"span>"

#: dist/prefs.js:171
msgid ""
"This slider allows you to change the balance of the current audio output"
msgstr ""
"Este controle deslizante permite que você altere o balanço da saída de áudio "
"atual"

#: dist/prefs.js:176 dist/prefs.js:187
msgid ""
"<span color=\"red\" weight=\"bold\">This feature needs <tt>pactl</tt></span>"
msgstr ""
"<span color=\"red\" weight=\"bold\">Este recurso precisa do  <tt>pactl</tt></"
"span>"

#: dist/prefs.js:182
msgid "This include for example the echo cancellation module"
msgstr "Isso inclui, por exemplo, o módulo de cancelamento de eco"

#: dist/prefs.js:205
msgid "Per-device sliders filtering"
msgstr "Filtragem dos controles por dispositivo"

#: dist/prefs.js:206
msgid ""
"Allows you to filter the per-device volume sliders. The content of the "
"filters are <b>regexes</b> and are applied to the device's display name and "
"pulseaudio name."
msgstr ""
"Permite filtrar os controles de volume por dispositivo. O conteúdo dos "
"filtros são <b>regexes (expressões regulares)<b> e são aplicados ao nome de "
"exibição do dispositivo e ao nome do pulseaudio."

#: dist/prefs.js:207
msgid "Device name"
msgstr "Nome do dispositivo"

#: dist/prefs.js:211
msgid "Application mixer filtering"
msgstr "Filtragem do mixer de aplicativos"

#: dist/prefs.js:212
msgid ""
"Allows you to filter the applications that show up in the application mixer "
"<b>using regexes</b>"
msgstr ""
"Permite filtrar os aplicativos que aparecem no mixer de aplicativos "
"<b>usando regexes (expressões regulares)<b>"

#: dist/prefs.js:213
msgid "Application name"
msgstr "Nome do aplicativo"

#: dist/prefs.js:224
msgid "Profile renamer"
msgstr "Renomeador de perfil"

#: dist/prefs.js:225
msgid ""
"Allows you to rename profiles of audio devices (only effective in the "
"profile switcher)"
msgstr ""
"Permite renomear perfis de dispositivos de áudio (eficaz apenas no "
"alternador de perfis)"

#: dist/prefs.js:247
msgid "Restore original name"
msgstr "Restaurar nome original"

#: dist/prefs.js:266
msgid "LibPanel settings"
msgstr "Configurações do LibPanel"

#: dist/prefs.js:267
msgid ""
"These settings are not specific to this extension, they apply to every panel"
msgstr ""
"Essas configurações não são específicas desta extensão, elas se aplicam a "
"todos os painéis"

#: dist/prefs.js:270
msgid "Lock panels"
msgstr "Travar painéis"

#: dist/prefs.js:271
msgid "Prevent panels from being moved via drag and drop"
msgstr "Impede que os painéis sejam movidos arrastando e soltando"

#: dist/prefs.js:274
msgid "Padding"
msgstr "Espaçamento interno"

#: dist/prefs.js:275
msgid "Use this to override the default padding of the panels"
msgstr "Use isto para sobrescrever o espaçamento interno padrão dos painéis"

#: dist/prefs.js:278
msgid "Row spacing"
msgstr "Espaçamento entre linhas"

#: dist/prefs.js:279
msgid "Use this to override the default row spacing of the panels"
msgstr "Use isto para sobrescrever o espaçamento padrão entre as linhas"

#: dist/prefs.js:282
msgid "Column spacing"
msgstr "Espaçamento entre colunas"

#: dist/prefs.js:283
msgid "Use this to override the default column spacing of the panels"
msgstr "Use isto para sobrescrever o espaçamento padrão entre as colunas"

#: dist/prefs.js:377
msgid "Filtering mode"
msgstr "Modo de filtragem"

#: dist/prefs.js:378
msgid ""
"On blocklist mode, matching elements are removed from the list. On allowlist "
"mode, only matching elements will be shown"
msgstr ""
"No modo de lista de bloqueio , os elementos correspondentes são removidos da "
"lista. No modo de lista de permissão, apenas os elementos correspondentes "
"serão mostrados"

#: dist/prefs.js:380
msgid "Blocklist"
msgstr "Lista de bloqueio"

#: dist/prefs.js:381
msgid "Allowlist"
msgstr "Lista de permissões"

#: dist/libs/widgets.js:310
msgid "Volume changed"
msgstr "Volume alterado"

#: dist/libs/widgets.js:576
msgid "Applications emitting sound"
msgstr "Aplicativos emitindo som"

#: dist/libs/widgets.js:580 dist/libs/widgets.js:638 dist/libs/widgets.js:647
msgid "Applications volumes"
msgstr "Volume dos aplicativos"

#: dist/libs/widgets.js:704
msgid "Output Device"
msgstr "Dispositivo de saída"

